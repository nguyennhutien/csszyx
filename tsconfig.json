{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        // TS 6: paths resolve from tsconfig.json directory; baseUrl deprecated.
        "paths": {
            "@csszyx/compiler": ["./packages/compiler/src"],
            "@csszyx/compiler/migrate": ["./packages/compiler/src/migrate-rust.ts"],
            "@csszyx/compiler/internal": ["./packages/compiler/src/internal.ts"],
            "@csszyx/compiler/engine": ["./packages/compiler/src/engine.ts"],
            "@csszyx/compiler/report": ["./packages/compiler/src/report.ts"],
            "@csszyx/types": ["./packages/types/src"],
            "@csszyx/runtime": ["./packages/runtime/src"],
            "@csszyx/cli": ["./packages/cli/src"],
            "@csszyx/unplugin": ["./packages/unplugin/src"],
            "@csszyx/dynamic": ["./packages/dynamic/src/index.ts"],
            "@csszyx/dynamic/react": ["./packages/dynamic/src/react.ts"]
        }
    },
    "files": [],
    "references": [
        { "path": "./packages/compiler" },
        { "path": "./packages/runtime" },
        { "path": "./packages/types" },
        { "path": "./packages/dynamic" },
        { "path": "./packages/cli" },
        { "path": "./packages/svelte-adapter" },
        { "path": "./packages/vue-adapter" },
        { "path": "./packages/unplugin" },
        { "path": "./packages/csszyx" },
        { "path": "./packages/mcp-server" },
        { "path": "./packages/vscode" },
        { "path": "./packages/vars" }
    ]
}
