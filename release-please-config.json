{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "release-type": "node",
    "bump-minor-pre-major": true,
    "include-component-in-tag": true,
    "include-v-in-tag": false,
    "separate-pull-requests": false,
    "bootstrap-sha": "18ce86cf3547b7d94c812e3966f78b7feb835d14",
    "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "revert", "section": "Reverts" },
        { "type": "refactor", "hidden": true },
        { "type": "test", "hidden": true },
        { "type": "ci", "hidden": true },
        { "type": "build", "hidden": true },
        { "type": "chore", "hidden": true },
        { "type": "docs", "hidden": true },
        { "type": "style", "hidden": true }
    ],
    "packages": {
        "packages/csszyx": {
            "package-name": "csszyx"
        },
        "packages/compiler": {
            "package-name": "@csszyx/compiler",
            "skip-github-release": true
        },
        "packages/runtime": {
            "package-name": "@csszyx/runtime",
            "skip-github-release": true
        },
        "packages/core": {
            "package-name": "@csszyx/core",
            "skip-github-release": true
        },
        "packages/types": {
            "package-name": "@csszyx/types",
            "skip-github-release": true
        },
        "packages/unplugin": {
            "package-name": "@csszyx/unplugin",
            "skip-github-release": true
        },
        "packages/cli": {
            "package-name": "@csszyx/cli",
            "skip-github-release": true
        },
        "packages/vars": {
            "package-name": "@csszyx/vars",
            "skip-github-release": true
        },
        "packages/mcp-server": {
            "package-name": "@csszyx/mcp-server",
            "skip-github-release": true
        },
        "packages/svelte-adapter": {
            "package-name": "@csszyx/svelte-adapter",
            "skip-github-release": true
        },
        "packages/vue-adapter": {
            "package-name": "@csszyx/vue-adapter",
            "skip-github-release": true
        },
        "packages/dynamic": {
            "package-name": "@csszyx/dynamic",
            "skip-github-release": true
        },
        "packages/vscode": {
            "package-name": "@csszyx/vscode",
            "skip-github-release": true
        }
    },
    "plugins": [
        {
            "type": "linked-versions",
            "groupName": "csszyx",
            "components": [
                "csszyx",
                "@csszyx/compiler",
                "@csszyx/runtime",
                "@csszyx/core",
                "@csszyx/types",
                "@csszyx/unplugin",
                "@csszyx/cli",
                "@csszyx/vars",
                "@csszyx/mcp-server",
                "@csszyx/svelte-adapter",
                "@csszyx/vue-adapter",
                "@csszyx/dynamic",
                "@csszyx/vscode"
            ]
        }
    ]
}
