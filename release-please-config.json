{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore${scope}: release ${component} v${version}",
  "bootstrap-sha": "18ce86cf3547b7d94c812e3966f78b7feb835d14",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "refactor", "hidden": true },
    { "type": "test", "hidden": true },
    { "type": "ci", "hidden": true },
    { "type": "build", "hidden": true },
    { "type": "chore", "hidden": true },
    { "type": "docs", "hidden": true },
    { "type": "style", "hidden": true }
  ],
  "exclude-paths": [
    "release-please-config.json",
    ".release-please-manifest.json",
    "packages/types/packages/csszyx"
  ],
  "packages": {
    ".": {
      "package-name": "csszyx",
      "changelog-path": "packages/csszyx/CHANGELOG.md",
      "extra-files": [
        "packages/csszyx/package.json",
        "packages/types/package.json",
        "packages/compiler/package.json",
        "packages/runtime/package.json",
        "packages/core/package.json",
        "packages/core-darwin-arm64/package.json",
        "packages/core-darwin-x64/package.json",
        "packages/core-linux-arm64-gnu/package.json",
        "packages/core-linux-arm64-musl/package.json",
        "packages/core-linux-x64-gnu/package.json",
        "packages/core-linux-x64-musl/package.json",
        "packages/core-win32-arm64-msvc/package.json",
        "packages/core-win32-x64-msvc/package.json",
        "packages/unplugin/package.json",
        "packages/cli/package.json",
        "packages/vars/package.json",
        "packages/mcp-server/package.json",
        "packages/svelte-adapter/package.json",
        "packages/vue-adapter/package.json",
        "packages/dynamic/package.json",
        "packages/vscode/package.json"
      ]
    }
  }
}
