{
  "name": "Antigravity Sandbox (csszyx)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "CODEX_HOME": "/root/.codex-devcontainer",
    "CLAUDE_CONFIG_DIR": "/root/.claude-devcontainer",
    "IS_SANDBOX": "1"
  },
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/tmp/host-ssh-agent.sock"
  },
  "mounts": [
    "source=${localEnv:HOME}/.gemini,target=/root/.gemini,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.codex,target=/root/.codex,type=bind,consistency=cached",
    "source=${localEnv:SSH_AUTH_SOCK},target=/tmp/host-ssh-agent.sock,type=bind"
  ],
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "henrikdev.ag-quota"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "root",
  "workspaceFolder": "/workspaces/csszyx",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/cleanup-credentials.sh && bash .devcontainer/configure-codex.sh && bash .devcontainer/configure-claude.sh && bash .devcontainer/healthcheck.sh && bash .devcontainer/init-firewall.sh && bash .devcontainer/security-envelope-check.sh"
}
