{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local", "tsdown.base.mjs"],
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "lib/**", "pkg-parser/**"],
      "env": ["NODE_ENV", "CSSZYX_REQUIRE_WASM_OPT"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "tests/**", "test/**", "*.config.js", "*.config.ts"]
    },
    // The engine is a cargo workspace member: cargo reads the ROOT Cargo.toml
    // (release profile), Cargo.lock and rust-toolchain.toml, none of which is
    // inside packages/core, so the default inputs never saw them. The engine's
    // source digest covers Cargo.lock, and the compiler build bakes in the
    // digest it expects; a lockfile change that rebuilt the compiler but
    // replayed a cached engine left the two disagreeing, and every engine call
    // threw engine-version-skew. KEEP outputs AND env IN SYNC WITH `build`.
    // `CSSZYX_REQUIRE_WASM_OPT` is in the key so the release, which sets it,
    // never replays a wasm build that skipped the optimizer.
    "@csszyx/core#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "lib/**", "pkg-parser/**"],
      "env": ["NODE_ENV", "CSSZYX_REQUIRE_WASM_OPT"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml"
      ]
    },
    // Tests that read files OUTSIDE their own package need those paths declared
    // here. `inputs` is package-scoped, so a cross-package read is invisible to
    // the cache key: measured on the docs sync suite, a wrong value injected
    // into a reference table replayed as 4583 passed while a direct vitest run
    // failed on it — and CI restores this cache, so the hole sat on the merge
    // gate. `$TURBO_ROOT$` anchors a path at the workspace root.
    //
    // The compiler's szv oracle test imports @csszyx/runtime to compare emitted
    // strings against the real factory path, but runtime is NOT a dependency of
    // compiler, so the generic ^build above never builds it. Declaring it in
    // package.json is impossible: runtime already depends on compiler, and the
    // devDependency would make compiler#build depend on runtime#build depend on
    // compiler#build, which turbo rejects as a cycle. So the edge lives here.
    //
    // KEEP outputs AND inputs IN SYNC WITH `test` ABOVE. A package-specific task
    // config REPLACES the generic one rather than merging into it: drop them and
    // this task silently loses output caching and takes the WHOLE package as its
    // input, including README.md and tsconfig.json.
    "@csszyx/compiler#test": {
      "dependsOn": ["^build", "@csszyx/runtime#build"],
      "env": ["CSSZYX_TEST_WASM_ONLY", "CSSZYX_REQUIRE_NATIVE"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "tests/**",
        "test/**",
        "*.config.js",
        "*.config.ts",
        "$TURBO_ROOT$/apps/docs/src/content/docs/docs/reference/*.mdx",
        "$TURBO_ROOT$/packages/types/src/config.ts",
        "$TURBO_ROOT$/packages/unplugin/README.md",
        // `dev-warning-guard.test.ts` reads the sources of every package that
        // reports a diagnostic, not only its own.
        "$TURBO_ROOT$/packages/runtime/src/**",
        "$TURBO_ROOT$/packages/dynamic/src/**",
        "$TURBO_ROOT$/packages/csszyx/src/**"
      ]
    },
    // The runtime and dynamic suites pin each console line through the
    // compiler's `tests/engine-message.ts`, the one spelling of a line's shape
    // every lane's suites share; a change there must re-run them.
    //
    // KEEP outputs AND inputs IN SYNC WITH `test` ABOVE. A package-specific task
    // config REPLACES the generic one rather than merging into it.
    "@csszyx/runtime#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "tests/**",
        "test/**",
        "*.config.js",
        "*.config.ts",
        "$TURBO_ROOT$/packages/compiler/tests/engine-message.ts"
      ]
    },
    "@csszyx/dynamic#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "tests/**",
        "test/**",
        "*.config.js",
        "*.config.ts",
        "$TURBO_ROOT$/packages/compiler/tests/engine-message.ts"
      ]
    },
    // The umbrella's browser-entry test bundles the `csszyx` specifier itself,
    // so it reads this package's own dist through its `exports` map — hence the
    // extra `build` edge, which the generic `^build` above does not cover. The
    // map is what the test pins, so package.json joins the inputs; without it a
    // condition could be dropped and turbo would replay a stale pass.
    //
    // KEEP outputs AND inputs IN SYNC WITH `test` ABOVE. A package-specific task
    // config REPLACES the generic one rather than merging into it.
    "csszyx#test": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "tests/**",
        "test/**",
        "package.json",
        "*.config.js",
        "*.config.ts",
        "$TURBO_ROOT$/packages/compiler/tests/engine-message.ts"
      ]
    },
    // The Jest transformer reads the Tailwind prefix in a child process, and a
    // child can only run built JavaScript, so it imports this package's own
    // `dist/next-prebuild.mjs`. Its suite therefore needs this package built,
    // which the generic `^build` above does not do.
    //
    // KEEP outputs AND inputs IN SYNC WITH `test` ABOVE. A package-specific task
    // config REPLACES the generic one rather than merging into it.
    "@csszyx/unplugin#test": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "tests/**", "test/**", "*.config.js", "*.config.ts"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
