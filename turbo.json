{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "pipeline": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "lib/**", "pkg/**"],
            "env": ["NODE_ENV"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/**"],
            "inputs": ["src/**", "tests/**", "test/**", "*.config.js", "*.config.ts"]
        },
        "test:watch": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "outputs": []
        },
        "type-check": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "clean": {
            "cache": false
        }
    }
}
