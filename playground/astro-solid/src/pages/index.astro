---
import NewsApp from '../components/NewsApp';
import ToneCallout from '../components/ToneCallout';
import { articles } from '../data/articles';
import '../styles.css';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>CSSzyx Solid News Playground</title>
    </head>
    <body>
        <ToneCallout tone="info" message="Server-rendered conditional spread." />
        <ToneCallout tone="warn" message="Hydrated conditional spread." client:load />
        <NewsApp articles={articles} client:load />
    </body>
</html>
