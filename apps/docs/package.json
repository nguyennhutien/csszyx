{
    "name": "@csszyx/docs",
    "version": "0.3.3",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "node -e \"require('fs').copyFileSync(require.resolve('csszyx/browser'), 'public/csszyx.js')\"",
        "dev": "astro dev",
        "prebuild": "node -e \"require('fs').copyFileSync(require.resolve('csszyx/browser'), 'public/csszyx.js')\"",
        "build": "astro build",
        "test": "vitest run --config vitest.config.ts",
        "preview": "astro preview",
        "clean:build": "rm -rf dist",
        "clean": "rm -rf node_modules && clean:build",
        "pages:preview": "pnpm build && wrangler pages dev dist",
        "pages:deploy": "pnpm build && wrangler pages deploy dist"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "^7.3.0",
        "@astrojs/react": "^6.0.5",
        "@astrojs/starlight": "^0.42.0",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "~7.2.10",
        "csszyx": "workspace:*",
        "expressive-code-twoslash": "^0.6.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "remark-gfm": "^4.0.1",
        "sharp": "^0.35.4",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "typescript": "^6.0.3",
        "wrangler": "^4.128.0"
    }
}
