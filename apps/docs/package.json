{
    "name": "@csszyx/docs",
    "version": "0.3.3",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "node -e \"require('fs').copyFileSync(require.resolve('csszyx/browser'), 'public/csszyx.js')\"",
        "dev": "astro dev",
        "prebuild": "node -e \"require('fs').copyFileSync(require.resolve('csszyx/browser'), 'public/csszyx.js')\"",
        "build": "astro build",
        "preview": "astro preview",
        "clean:build": "rm -rf dist",
        "clean": "rm -rf node_modules && clean:build",
        "pages:preview": "pnpm build && wrangler pages dev dist",
        "pages:deploy": "pnpm build && wrangler pages deploy dist"
    },
    "dependencies": {
        "@astrojs/react": "^5.0.7",
        "@astrojs/starlight": "^0.41.0",
        "@tailwindcss/vite": "^4.3.1",
        "astro": "^6.4.8",
        "csszyx": "workspace:*",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "expressive-code-twoslash": "^0.6.1",
        "remark-gfm": "^4.0.1",
        "sharp": "^0.35.2",
        "tailwindcss": "^4.3.0"
    },
    "devDependencies": {
        "wrangler": "^4.92.0"
    }
}
