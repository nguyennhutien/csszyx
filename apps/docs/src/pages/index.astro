---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingHeader from '../components/landing/LandingHeader';
import HeroSection from '../components/landing/HeroSection';
import EmpoweringSection from '../components/landing/EmpoweringSection';
import DeltaSection from '../components/landing/DeltaSection';
import BenchmarksSection from '../components/landing/BenchmarksSection';
import CTASection from '../components/landing/CTASection';
import LandingFooter from '../components/landing/LandingFooter';
---

<LandingLayout
  title="CSSzyx — Style from data. Zero wasted CSS."
  description="CSSzyx compiles sz props to Tailwind at build time. For runtime dynamic styles — from APIs, CMS, or user config — it injects only the exact CSS delta you need."
>
  <!-- Fixed Header -->
  <LandingHeader client:load />

  <!-- Main content (hero) -->
  <main>
    <HeroSection client:load />

    <!-- Empowering Library Authors -->
    <div class="max-w-screen-2xl mx-auto px-6 lg:px-20">
      <EmpoweringSection client:visible />
    </div>

    <!-- Delta Architecture -->
    <div class="max-w-screen-2xl mx-auto px-6 lg:px-20">
      <DeltaSection client:visible />
    </div>

    <!-- Benchmarks (bg spans full width) -->
    <BenchmarksSection client:visible />

    <!-- CTA Section -->
    <CTASection client:visible />
  </main>

  <!-- Footer -->
  <LandingFooter client:visible />
</LandingLayout>
