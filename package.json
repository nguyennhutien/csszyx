{
  "name": "csszyx",
  "version": "0.10.8",
  "type": "module",
  "private": true,
  "description": "CSS-in-JS framework with Tailwind object syntax, automatic minification, and SSR safety. Class names encode in reversed order z→y→x.",
  "keywords": [
    "css-in-js",
    "tailwind",
    "typescript",
    "react",
    "ssr",
    "hydration",
    "minification"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyennhutien/csszyx.git"
  },
  "author": "Tien Nguyen",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "postinstall": "[ -f .agent/fix-linux-arm64-binaries.sh ] && bash .agent/fix-linux-arm64-binaries.sh || true",
    "gen:llms": "node scripts/gen-llms.mjs",
    "gen:parity-corpus": "node --import tsx/esm scripts/gen-rust-parity-corpus.mjs",
    "gen:parity-corpus:check": "node --import tsx/esm scripts/gen-rust-parity-corpus.mjs --check",
    "gen:parse-parity-corpus": "node --import tsx/esm scripts/gen-rust-parse-parity-corpus.mjs",
    "gen:rust-tables": "node scripts/generate-rust-transform-tables.mjs",
    "gen:rust-tables:check": "node scripts/generate-rust-transform-tables.mjs --check",
    "gen:key-tests": "node --import tsx/esm scripts/gen-key-tests.mjs",
    "gen:key-tests:check": "node --import tsx/esm scripts/gen-key-tests.mjs --check",
    "gen:box-role": "node --import tsx/esm scripts/gen-box-role-map.mjs",
    "gen:box-role:check": "node --import tsx/esm scripts/gen-box-role-map.mjs --check",
    "gen:sz-allowlist": "node --import tsx/esm scripts/gen-sz-allowlist.mjs",
    "gen:sz-allowlist:check": "node --import tsx/esm scripts/gen-sz-allowlist.mjs --check",
    "check:key-corpus": "node scripts/check-key-corpus-consistency.mjs",
    "build": "pnpm run gen:llms && turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=!@csszyx/e2e",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter @csszyx/e2e test",
    "serve:vanilla": "npx vite playground/vanilla-html --port 5176",
    "lint:fast": "biome check",
    "lint": "biome check --write && eslint . --fix --cache --cache-location node_modules/.cache/eslint",
    "lint:check": "biome check && eslint . --cache --cache-location node_modules/.cache/eslint",
    "type-check": "tsc -b",
    "security:secrets": "gitleaks dir . --no-banner",
    "security:sast": "semgrep scan --config rules/ --severity ERROR --error --metrics=off",
    "security:sca": "pnpm audit --audit-level high --ignore-unfixable && npx --yes lockfile-lint@4 --path pnpm-lock.yaml --type pnpm --allowed-hosts npm --validate-https",
    "verify:ci": "bash scripts/verify-like-ci.sh",
    "verify:ci:fast": "bash scripts/verify-like-ci.sh --no-e2e",
    "verify:pre-push": "bash scripts/verify-pre-push.sh",
    "pr:ready": "pnpm verify:ci && echo '\\n✓ Full CI mirror green locally. Push the branch then run `gh pr create` when ready.'",
    "clean": "rm -rf node_modules .turbo packages/*/node_modules packages/*/dist packages/*/.csszyx packages/core-*/*.node playground/*/node_modules playground/*/dist playground/*/out playground/*/.next playground/*/.next-turbo* playground/*/.astro playground/*/.csszyx playground/.csszyx apps/*/dist apps/*/.astro apps/*/.csszyx csszyx-classes.html csszyx-classes.js playground/*/csszyx-classes.html apps/*/csszyx-classes.html .csszyx-todo.json playground/*/.csszyx-todo.json",
    "reset": "pnpm clean && pnpm install && node scripts/ensure-host-native.mjs && turbo run build --filter='./packages/*'",
    "corpus:check": "node --import tsx/esm scripts/check-corpus.ts",
    "corpus:check:strict": "node --import tsx/esm scripts/check-corpus.ts --fail-fast",
    "corpus:extract": "node --import tsx/esm scripts/extract-corpus.ts",
    "compiler:profile-hotpath": "node --import tsx/esm scripts/profile-compiler-hotpath.ts",
    "bench:transform-cache": "node --import tsx/esm scripts/bench-transform-cache.ts",
    "bench:css-vars": "node --import tsx/esm scripts/bench-css-var-system.ts",
    "bench:cli-migrate": "node --import tsx/esm scripts/bench-cli-migrate.ts",
    "bench:global-vars": "node --import tsx/esm scripts/bench-global-var-mangling.ts",
    "bench:docs-build": "node --import tsx/esm scripts/bench-docs-build.ts",
    "bench:docs-size": "node --import tsx/esm scripts/bench-docs-output-size.ts",
    "bench:vite-react-size": "node --import tsx/esm scripts/bench-vite-react-output-size.ts",
    "bench:docs-hmr": "node --import tsx/esm scripts/bench-docs-hmr.ts",
    "observe:rust-parser-paths": "node --import tsx/esm scripts/observe-rust-parser-paths.ts",
    "pages:build": "bash scripts/build-cf-pages.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@playwright/test": "^1.61.1",
    "@rollup/rollup-linux-arm64-gnu": "*",
    "@tailwindcss/oxide-darwin-arm64": "*",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^62.1.0",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-security": "4.0.1",
    "lefthook": "^2.1.9",
    "markdownlint-cli": "^0.49.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "unbuild": "3.6.1",
    "vite": "^8.1.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "devalue@>=5.0.0 <5.8.1": "^5.8.1",
      "esbuild@>=0.17.0 <0.28.1": "^0.28.1",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "http-proxy-middleware@>=2.0.0 <3.0.6": "^3.0.6",
      "js-yaml@>=4.0.0 <4.2.0": "^4.2.0",
      "lodash@>=4.0.0 <4.18.0": "^4.18.1",
      "markdown-it@>=14.0.0 <14.2.0": "^14.2.0",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.5",
      "postcss@>=8.0.0 <8.5.10": "^8.5.15",
      "qs@>=6.0.0 <6.15.2": "^6.15.2",
      "shell-quote@>=1.0.0 <1.8.4": "^1.8.4",
      "tmp@>=0.2.0 <0.2.6": "^0.2.7",
      "undici@>=7.0.0 <7.28.0": "^7.28.0",
      "vite@>=6.0.0 <6.4.3": "^6.4.3",
      "vite@>=7.0.0 <7.3.2": "^7.3.5",
      "vite@>=8.0.0 <8.0.16": "^8.0.16",
      "ws@>=8.0.0 <8.20.1": "^8.21.0"
    },
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux",
        "win32"
      ],
      "cpu": [
        "x64",
        "arm64"
      ],
      "libc": [
        "glibc",
        "musl"
      ]
    }
  },
  "packageManager": "pnpm@10.32.1"
}
