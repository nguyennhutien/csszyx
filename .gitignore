.tmp/
.cache/

# Local codegraph index (generated; one shared source via workspace bind-mount,
# never committed). Previously ignored via .git/info/exclude by the now-removed
# .agent/install-codegraph.sh — tracked here so a fresh clone ignores it too.
.codegraph/

# AI agent docs — tracked on internal/docs branch, private remote only.
# To commit changes: git docs "your message"
# To view history:   git log internal/docs -- AGENTS.md .agent/
# Remote:            git@github.com:nguyennhutien/csszyx-internal.git
AGENTS.md
CLAUDE.md
.agent/
.claude/
.cursorrules
docs/guides/ai-usage.md

# release-please writes/reads packages/*/CHANGELOG.md as the source of truth
# for each package's release history. Track them all so release-please can
# diff against the prior state on each run. Single GitHub Release per
# release cycle still points only at packages/csszyx/CHANGELOG.md (config:
# skip-github-release: true on non-csszyx packages).
apps/*/CHANGELOG.md

# Rust
# Cargo.lock (Un-ignored to ensure reproducible builds)
