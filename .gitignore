# CSSzyx
csszyx-classes.html
csszyx-classes.js
.csszyx/

# Local context instruction
context-instruction/
.claude/

# Dependencies
node_modules/
pnpm-store/
.pnpm-store/
.pnp
.pnp.js

# Build outputs
dist/
lib/
# wasm-pack outputs — both bundler (pkg/) and nodejs (pkg-node/) targets are
# generated by `pnpm build` in @csszyx/core and shipped via the npm tarball,
# so they don't need to live in git. Turbo's `^build` dependency chain
# rebuilds them on demand when consumers run `pnpm build` / `pnpm test` at
# the workspace root. `prepublishOnly` re-verifies them before npm publish.
pkg/
pkg-node/
target/
*.wasm
# Native platform packages are built from @csszyx/core and published as npm
# artifacts. Keep generated binaries out of source control.
packages/core-*/*.node
# VS Code extension packaging output (see packages/vscode/scripts/package.mjs)
*.vsix
# MCP server bundles llms-full.txt from apps/docs/public at build time
packages/mcp-server/llms-full.txt
# Browser runtime IIFE — copied from csszyx package dist by docs prebuild hook.
apps/docs/public/csszyx.js

# Testing
coverage/
.nyc_output/

# Next.js
.next/
.next*/
out/
# Auto-generated by Next on every dev/build; flips with the active build mode.
next-env.d.ts

# Astro generated content/type declarations — regenerated on every build (the
# docs app already ignores its own, this also covers a stray repo-root `.astro/`).
.astro/
# Wrangler (Cloudflare) local dev state + miniflare cache.
.wrangler/
*.wrangler/

# Misc
.DS_Store
*.pem
.env*.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Turbo
.turbo/

# Playwright
playwright-report/
test-results/
blob-report/
playwright/.cache/
/

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
.tmp/
.cache/

# AI agent docs — tracked on internal/docs branch, private remote only.
# To commit changes: git docs "your message"
# To view history:   git log internal/docs -- AGENTS.md .agent/
# Remote:            git@github.com:nguyennhutien/csszyx-internal.git
AGENTS.md
CLAUDE.md
.agent/
.claude/
.cursorrules
docs/guides/ai-usage.md

# release-please writes/reads packages/*/CHANGELOG.md as the source of truth
# for each package's release history. Track them all so release-please can
# diff against the prior state on each run. Single GitHub Release per
# release cycle still points only at packages/csszyx/CHANGELOG.md (config:
# skip-github-release: true on non-csszyx packages).
apps/*/CHANGELOG.md

# Rust
# Cargo.lock (Un-ignored to ensure reproducible builds)
