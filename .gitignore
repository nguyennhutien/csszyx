# AI agent docs — tracked on internal/docs branch, private remote only.
# To commit changes: git docs "your message"
# To view history:   git log internal/docs -- .agent/
# Remote:            git@github.com:nguyennhutien/csszyx-internal.git
CLAUDE.md
.agent/
.claude/
.cursorrules
docs/guides/ai-usage.md

# Per-package CHANGELOGs — only packages/csszyx/CHANGELOG.md is published.
# `changeset version` generates one per package; action reads them to build
# the Version Packages PR body (must exist on disk), but we don't commit them.
packages/*/CHANGELOG.md
!packages/csszyx/CHANGELOG.md
apps/*/CHANGELOG.md

