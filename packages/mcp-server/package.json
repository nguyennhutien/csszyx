{
  "name": "@csszyx/mcp-server",
  "version": "0.9.3",
  "private": true,
  "description": "Model Context Protocol (MCP) server for csszyx — enables AI agents to understand and generate sz props",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "csszyx-mcp": "./dist/index.mjs"
  },
  "scripts": {
    "build": "unbuild",
    "start": "node dist/index.mjs",
    "dev": "unbuild --stub",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "llms-full.txt"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "@csszyx/compiler": "workspace:*",
    "@csszyx/cli": "workspace:*",
    "@csszyx/unplugin": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "vitest": "^4.1.6",
    "unbuild": "^3.6.1"
  },
  "keywords": [
    "csszyx",
    "mcp",
    "model-context-protocol",
    "ai",
    "tailwindcss",
    "sz-prop"
  ]
}
