{
  "name": "@csszyx/mcp-server",
  "version": "0.15.1",
  "description": "Model Context Protocol (MCP) server for csszyx — enables AI agents to understand and generate sz props",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/mcp-server"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "csszyx-mcp": "./dist/index.mjs"
  },
  "scripts": {
    "build": "unbuild",
    "start": "node dist/index.mjs",
    "dev": "unbuild --stub",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "llms-full.txt"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "dependencies": {
    "@csszyx/cli": "workspace:*",
    "@csszyx/compiler": "workspace:*",
    "@csszyx/unplugin": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "csszyx",
    "mcp",
    "model-context-protocol",
    "ai",
    "tailwindcss",
    "sz-prop"
  ]
}
