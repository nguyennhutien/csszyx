{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./.tsout",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "composite": true,
        "incremental": true,
        "isolatedDeclarations": false,
        "declaration": true,
        "declarationMap": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "tsBuildInfoFile": "./.tsout/tsconfig.tsbuildinfo",
        "sourceMap": true
    },
    "references": [{ "path": "../compiler" }, { "path": "../cli" }, { "path": "../unplugin" }],
    "include": ["src/**/*"],
    "exclude": ["tests/**/*", "dist/**/*"]
}
