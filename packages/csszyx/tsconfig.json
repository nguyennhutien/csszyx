{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "incremental": true,
        "isolatedDeclarations": true,
        "declaration": true,
        "tsBuildInfoFile": "./.tsout/tsconfig.tsbuildinfo",
        "outDir": "./.tsout",
        "rootDir": "./src",
        "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"],
    "references": [
        { "path": "../compiler" },
        { "path": "../runtime" },
        { "path": "../types" },
        { "path": "../dynamic" },
        { "path": "../unplugin" }
    ]
}
