{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "incremental": true,
        "isolatedDeclarations": true,
        "declaration": true,
        "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
        "outDir": "./dist",
        "rootDir": "./src",
        "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"],
    "references": [
        { "path": "../compiler" },
        { "path": "../runtime" },
        { "path": "../types" },
        { "path": "../dynamic" },
        { "path": "../unplugin" }
    ]
}
