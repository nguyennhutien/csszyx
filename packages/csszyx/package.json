{
  "name": "csszyx",
  "version": "0.11.4",
  "description": "Universal CSS-in-JS for Tailwind CSS with WASM core",
  "keywords": [
    "css",
    "tailwind",
    "css-in-js",
    "utility-first",
    "ssr",
    "react",
    "vue",
    "svelte",
    "wasm"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "unpkg": "./dist/browser.iife.js",
  "jsdelivr": "./dist/browser.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./lite": {
      "types": "./dist/lite.d.mts",
      "import": "./dist/lite.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.mts",
      "import": "./dist/webpack.mjs"
    },
    "./dynamic": {
      "types": "./dist/dynamic.d.mts",
      "import": "./dist/dynamic.mjs"
    },
    "./dynamic/react": {
      "types": "./dist/dynamic-react.d.mts",
      "import": "./dist/dynamic-react.mjs"
    },
    "./browser": "./dist/browser.iife.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run"
  },
  "dependencies": {
    "@csszyx/core": "workspace:*",
    "@csszyx/runtime": "workspace:*",
    "@csszyx/compiler": "workspace:*",
    "@csszyx/unplugin": "workspace:*",
    "@csszyx/types": "workspace:*",
    "@csszyx/dynamic": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "vitest": "^4.1.9",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
