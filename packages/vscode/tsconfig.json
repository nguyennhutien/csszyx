{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // VS Code extension host runs CommonJS, not ESM
        "module": "CommonJS",
        "composite": true,
        "incremental": true,
        "isolatedDeclarations": true,
        "outDir": "./.tsout",
        "rootDir": "./src",
        "declaration": true,
        "declarationMap": true,
        "tsBuildInfoFile": "./.tsout/tsconfig.tsbuildinfo",
        // VS Code extension needs the vscode + node typings; DOM globals
        // (setTimeout etc) come from node.
        "types": ["node", "vscode"]
    },
    "references": [{ "path": "../compiler" }],
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
