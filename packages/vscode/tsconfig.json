{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // VS Code extension host runs CommonJS, not ESM
        "module": "CommonJS",
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": false,
        "declarationMap": false,
        // VS Code extension needs the vscode + node typings; DOM globals
        // (setTimeout etc) come from node.
        "types": ["node", "vscode"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
