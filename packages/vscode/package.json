{
  "name": "@csszyx/vscode",
  "private": true,
  "displayName": "CSSzyx",
  "description": "IntelliSense, hover docs, and diagnostics for CSSzyx sz props",
  "version": "0.10.2",
  "publisher": "csszyx",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://csszyx.com",
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "csszyx",
    "tailwind",
    "css-in-js",
    "intellisense"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/vscode"
  },
  "activationEvents": [
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:html"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.sz.injection",
        "path": "./syntaxes/sz.tmGrammar.json",
        "injectTo": [
          "source.tsx",
          "source.ts",
          "source.jsx",
          "source.js",
          "text.html.basic",
          "text.html.derivative"
        ]
      }
    ],
    "configuration": {
      "title": "CSSzyx",
      "properties": {
        "csszyx.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Report unknown sz props as warnings."
        },
        "csszyx.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "Show generated Tailwind classes on hover."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vsix": "pnpm build && node scripts/package.mjs",
    "vsix:publish": "pnpm build && node scripts/package.mjs --publish"
  },
  "devDependencies": {
    "@babel/parser": "^7.23.0",
    "@csszyx/compiler": "workspace:*",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
