{
    "scopeName": "source.sz.injection",
    "injectionSelector": "L:source.tsx, L:source.ts, L:source.jsx, L:source.js, L:text.html.basic, L:text.html.derivative",
    "patterns": [
        {
            "comment": "HTML double-quoted sz attribute — covers both explicit `sz=\"{...}\"` and implicit `sz=\"k: v\"` forms. MUST precede the bare `sz` match below: TextMate picks the first matching pattern at a given position, not the longest — if the bare match wins, the begin never gets a chance and HTML's attribute parser takes over the rest of the attribute.",
            "name": "meta.attribute.sz.html.csszyx",
            "begin": "(\\bsz)(=)(\")",
            "beginCaptures": {
                "1": {
                    "name": "entity.other.attribute-name.sz.csszyx support.type.property-name.csszyx"
                },
                "2": { "name": "punctuation.separator.key-value.html" },
                "3": { "name": "punctuation.definition.string.begin.html" }
            },
            "end": "(\")",
            "endCaptures": {
                "1": { "name": "punctuation.definition.string.end.html" }
            },
            "patterns": [{ "include": "#sz-object-body" }]
        },
        {
            "comment": "HTML single-quoted sz attribute",
            "name": "meta.attribute.sz.html.csszyx",
            "begin": "(\\bsz)(=)(')",
            "beginCaptures": {
                "1": {
                    "name": "entity.other.attribute-name.sz.csszyx support.type.property-name.csszyx"
                },
                "2": { "name": "punctuation.separator.key-value.html" },
                "3": { "name": "punctuation.definition.string.begin.html" }
            },
            "end": "(')",
            "endCaptures": {
                "1": { "name": "punctuation.definition.string.end.html" }
            },
            "patterns": [{ "include": "#sz-object-body" }]
        },
        {
            "comment": "Fallback for JSX/TSX (`sz={{ ... }}`) where nothing above matched — color just the attribute name.",
            "match": "(?<![a-zA-Z0-9_$-])(sz)(?=\\s*=)",
            "captures": {
                "1": {
                    "name": "entity.other.attribute-name.sz.csszyx support.type.property-name.csszyx"
                }
            }
        }
    ],
    "repository": {
        "sz-object-body": {
            "patterns": [
                { "include": "#sz-braces" },
                { "include": "#sz-string-single" },
                { "include": "#sz-string-double" },
                { "include": "#sz-arbitrary" },
                { "include": "#sz-variant-key" },
                { "include": "#sz-key" },
                { "include": "#sz-number" },
                { "include": "#sz-boolean" },
                { "include": "#sz-punctuation" }
            ]
        },
        "sz-braces": {
            "match": "[{}]",
            "name": "punctuation.section.braces.csszyx"
        },
        "sz-string-single": {
            "name": "string.quoted.single.csszyx",
            "begin": "'",
            "end": "'",
            "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.csszyx" }]
        },
        "sz-string-double": {
            "name": "string.quoted.double.csszyx",
            "begin": "(?<!=)\"",
            "end": "\"",
            "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.csszyx" }]
        },
        "sz-arbitrary": {
            "name": "string.other.arbitrary.csszyx",
            "begin": "\\[",
            "end": "\\]",
            "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.csszyx" }]
        },
        "sz-variant-key": {
            "comment": "variant keys like hover:, focus:, sm:, dark: followed by an object { ... }",
            "match": "\\b(hover|focus|focusWithin|focusVisible|active|visited|target|first|last|only|odd|even|firstOfType|lastOfType|onlyOfType|empty|disabled|enabled|checked|indeterminate|default|required|valid|invalid|inRange|outOfRange|placeholderShown|autofill|readOnly|before|after|firstLetter|firstLine|marker|selection|file|backdrop|placeholder|sm|md|lg|xl|[2-5]xl|dark|light|portrait|landscape|motionSafe|motionReduce|contrastMore|contrastLess|print|rtl|ltr|group|groupHover|groupFocus|peer|peerHover|peerFocus|has|not|aria|data)\\s*(:)(?=\\s*\\{)",
            "captures": {
                "1": { "name": "keyword.control.variant.csszyx" },
                "2": { "name": "punctuation.separator.csszyx" }
            }
        },
        "sz-key": {
            "comment": "regular property keys like p, bg, color followed by :",
            "match": "\\b([a-zA-Z][a-zA-Z0-9_$]*)\\s*(:)",
            "captures": {
                "1": { "name": "support.type.property-name.csszyx" },
                "2": { "name": "punctuation.separator.csszyx" }
            }
        },
        "sz-number": {
            "match": "\\b-?\\d+(?:\\.\\d+)?\\b",
            "name": "constant.numeric.csszyx"
        },
        "sz-boolean": {
            "match": "\\b(true|false|null)\\b",
            "name": "constant.language.csszyx"
        },
        "sz-punctuation": {
            "match": "[,]",
            "name": "punctuation.separator.csszyx"
        }
    }
}
