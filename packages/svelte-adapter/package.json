{
  "name": "@csszyx/svelte-adapter",
  "version": "0.14.0",
  "private": false,
  "description": "Svelte preprocessor for csszyx - transforms sz props into Tailwind CSS classes",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/svelte-adapter#readme",
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@csszyx/compiler": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "svelte": "^5.56.8",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "csszyx",
    "svelte",
    "preprocessor",
    "tailwindcss",
    "css-in-js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/svelte-adapter"
  }
}
