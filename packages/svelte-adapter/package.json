{
    "name": "@csszyx/svelte-adapter",
    "version": "0.0.0",
    "private": true,
    "description": "Svelte preprocessor for csszyx - transforms sz props into Tailwind CSS classes",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --clean",
        "dev": "tsup src/index.ts --format esm --dts --watch",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@csszyx/compiler": "workspace:*"
    },
    "peerDependencies": {
        "svelte": "^4.0.0 || ^5.0.0"
    },
    "peerDependenciesMeta": {
        "svelte": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "svelte": "^5.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.3.3"
    },
    "keywords": [
        "csszyx",
        "svelte",
        "preprocessor",
        "tailwindcss",
        "css-in-js"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/nguyennhutien/csszyx.git",
        "directory": "packages/svelte-adapter"
    }
}
