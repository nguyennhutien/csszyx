{
    "compilerOptions": {
        "module": "node16",
        "moduleResolution": "node16",
        "target": "es2020",
        "lib": ["es2021"],
        "types": ["node"],
        "declaration": true,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "tests"]
}
