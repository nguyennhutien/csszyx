{
  "name": "@csszyx/core",
  "version": "0.7.0",
  "description": "WASM core for csszyx",
  "keywords": [
    "csszyx",
    "wasm",
    "rust",
    "core"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "main": "./pkg/csszyx_core.js",
  "types": "./pkg/csszyx_core.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/csszyx_core.d.ts",
      "node": "./pkg-node/csszyx_core.js",
      "default": "./pkg/csszyx_core.js"
    }
  },
  "files": [
    "pkg",
    "pkg-node"
  ],
  "scripts": {
    "build": "node scripts/preflight.mjs && wasm-pack build --mode no-install --target bundler --out-dir pkg && wasm-pack build --mode no-install --target nodejs --out-dir pkg-node && rm -f pkg/.gitignore pkg-node/.gitignore && node scripts/run-wasm-opt.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf pkg pkg-node target",
    "prepublishOnly": "node scripts/ensure-build.mjs --strict"
  },
  "devDependencies": {
    "vitest": "^1.2.0"
  }
}
