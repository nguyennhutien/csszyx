{
  "name": "@csszyx/core",
  "version": "0.8.0",
  "description": "WASM core for csszyx",
  "keywords": [
    "csszyx",
    "wasm",
    "rust",
    "core"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "main": "./pkg/csszyx_core.js",
  "types": "./pkg/csszyx_core.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/csszyx_core.d.ts",
      "node": "./pkg-node/csszyx_core.js",
      "default": "./pkg/csszyx_core.js"
    },
    "./native": {
      "types": "./native/index.d.ts",
      "node": "./native/index.js"
    }
  },
  "files": [
    "native",
    "pkg",
    "pkg-node"
  ],
  "napi": {
    "binaryName": "csszyx-core"
  },
  "scripts": {
    "build": "node scripts/preflight.mjs && wasm-pack build --mode no-install --target bundler --out-dir pkg && wasm-pack build --mode no-install --target nodejs --out-dir pkg-node && rm -f pkg/.gitignore pkg-node/.gitignore && node scripts/run-wasm-opt.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:check": "node scripts/check-native.mjs",
    "native:build": "node scripts/build-native.mjs --release",
    "native:engine:smoke": "node scripts/smoke-native-engine.mjs",
    "native:packages": "node scripts/validate-native-packages.mjs",
    "native:smoke": "node scripts/smoke-native.mjs",
    "clean": "rm -rf pkg pkg-node target",
    "prepublishOnly": "node scripts/ensure-build.mjs --strict"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.6.2",
    "vitest": "^4.1.6"
  },
  "optionalDependencies": {
    "@csszyx/core-darwin-arm64": "workspace:*",
    "@csszyx/core-darwin-x64": "workspace:*",
    "@csszyx/core-linux-arm64-gnu": "workspace:*",
    "@csszyx/core-linux-arm64-musl": "workspace:*",
    "@csszyx/core-linux-x64-gnu": "workspace:*",
    "@csszyx/core-linux-x64-musl": "workspace:*",
    "@csszyx/core-win32-arm64-msvc": "workspace:*",
    "@csszyx/core-win32-x64-msvc": "workspace:*"
  }
}
