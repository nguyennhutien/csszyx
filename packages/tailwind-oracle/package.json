{
  "name": "@csszyx/tailwind-oracle",
  "version": "0.17.0",
  "description": "Asks a project's own Tailwind whether a class name produces CSS",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/tailwind-oracle"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./project-walk": {
      "import": "./src/project-walk.ts",
      "types": "./src/project-walk.ts"
    },
    "./css-comments": {
      "import": "./src/css-comments.ts",
      "types": "./src/css-comments.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@csszyx/compiler": "workspace:*",
    "ignore": "7.0.6"
  },
  "sideEffects": false,
  "license": "MIT"
}
