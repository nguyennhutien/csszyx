{
  "name": "@csszyx/runtime",
  "version": "0.11.1",
  "description": "Runtime helpers and hydration guards for csszyx",
  "keywords": [
    "csszyx",
    "runtime",
    "css-in-js",
    "hydration"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lite": {
      "import": {
        "types": "./dist/lite.d.mts",
        "default": "./dist/lite.mjs"
      },
      "require": {
        "types": "./dist/lite.d.cts",
        "default": "./dist/lite.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@csszyx/compiler": "workspace:*",
    "@csszyx/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "jsdom": "^23.0.0",
    "typescript": "^6.0.3",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^4.1.9",
    "unbuild": "^3.6.1"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "^0.19.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
