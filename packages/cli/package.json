{
  "name": "@csszyx/cli",
  "version": "0.11.10",
  "description": "Command-line tools for csszyx",
  "keywords": [
    "csszyx",
    "cli",
    "tooling"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "bin": {
    "csszyx": "./dist/bin.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@csszyx/compiler": "workspace:*",
    "@csszyx/types": "workspace:*",
    "@csszyx/unplugin": "workspace:*",
    "cac": "^7.0.0",
    "chokidar": "^5.0.0",
    "execa": "^10.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.6",
    "minimatch": "^10.2.5",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.1",
    "@types/prompts": "^2.4.9",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10"
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
