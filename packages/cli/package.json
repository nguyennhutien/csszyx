  "description": "Command-line tools for csszyx",
  "keywords": [
    "csszyx",
    "cli",
    "tooling"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/cli#readme",
