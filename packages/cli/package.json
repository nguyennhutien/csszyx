{
  "name": "@csszyx/cli",
  "version": "0.11.9",
  "description": "Command-line tools for csszyx",
  "keywords": [
    "csszyx",
    "cli",
    "tooling"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "bin": {
    "csszyx": "./dist/bin.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub"
  },
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "@babel/types": "^7.23.0",
    "@csszyx/compiler": "workspace:*",
    "@csszyx/types": "workspace:*",
    "@csszyx/unplugin": "workspace:*",
    "cac": "^6.7.14",
    "chokidar": "^5.0.0",
    "execa": "^8.0.1",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "minimatch": "^10.2.5",
    "ora": "^9.4.0",
    "picocolors": "^1.0.0",
    "prompts": "^2.4.2",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.5",
    "@types/prompts": "^2.4.9",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.9"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
