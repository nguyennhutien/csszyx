{
  "name": "@csszyx/vue-adapter",
  "version": "0.10.0",
  "private": false,
  "description": "Vue SFC preprocessor for csszyx - transform sz props to className",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/vue-adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/vue-adapter"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@csszyx/compiler": "workspace:*",
    "oxc-parser": "0.131.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "vue": "^3.4.0",
    "unbuild": "^3.6.1"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "csszyx",
    "vue",
    "sfc",
    "preprocessor",
    "tailwind"
  ]
}
