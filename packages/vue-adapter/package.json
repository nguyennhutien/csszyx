{
  "name": "@csszyx/vue-adapter",
  "version": "0.8.0",
  "private": true,
  "description": "Vue SFC preprocessor for csszyx - transform sz props to className",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@csszyx/compiler": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vue": "^3.4.0",
    "unbuild": "^3.6.1"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "csszyx",
    "vue",
    "sfc",
    "preprocessor",
    "tailwind"
  ]
}
