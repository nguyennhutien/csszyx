{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "composite": true,
        "incremental": true,
        "isolatedDeclarations": true,
        "declaration": true,
        "declarationMap": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "tsBuildInfoFile": "./.tsout/tsconfig.tsbuildinfo",
        "outDir": "./.tsout",
        "rootDir": "./src"
    },
    "references": [{ "path": "../compiler" }],
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
