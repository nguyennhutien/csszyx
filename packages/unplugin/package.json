{
  "name": "@csszyx/unplugin",
  "version": "0.7.0",
  "description": "Vite and Webpack integration for csszyx",
  "keywords": [
    "csszyx",
    "vite",
    "webpack",
    "plugin",
    "css-in-js",
    "unplugin"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/unplugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/unplugin"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.mts",
      "import": "./dist/webpack.mjs",
      "require": "./dist/webpack.cjs"
    },
    "./css-mangler": {
      "types": "./dist/css-mangler.d.mts",
      "import": "./dist/css-mangler.mjs",
      "require": "./dist/css-mangler.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@csszyx/compiler": "workspace:*",
    "@csszyx/core": "workspace:*",
    "@csszyx/svelte-adapter": "workspace:*",
    "@csszyx/types": "workspace:*",
    "@csszyx/vue-adapter": "workspace:*",
    "postcss": "^8.4.35",
    "postcss-selector-parser": "^6.0.15",
    "unplugin": "^1.10.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.27.2",
    "rollup": "^4.56.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "webpack": "^5.104.1",
    "unbuild": "^3.6.1"
  }
}
