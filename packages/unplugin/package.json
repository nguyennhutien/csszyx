{
  "name": "@csszyx/unplugin",
  "version": "0.11.11",
  "description": "Vite and Webpack integration for csszyx",
  "keywords": [
    "csszyx",
    "vite",
    "webpack",
    "plugin",
    "css-in-js",
    "unplugin"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/unplugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/unplugin"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.mts",
        "default": "./dist/webpack.mjs"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./css-mangler": {
      "import": {
        "types": "./dist/css-mangler.d.mts",
        "default": "./dist/css-mangler.mjs"
      },
      "require": {
        "types": "./dist/css-mangler.d.cts",
        "default": "./dist/css-mangler.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next-config.d.mts",
        "default": "./dist/next-config.mjs"
      },
      "require": {
        "types": "./dist/next-config.d.cts",
        "default": "./dist/next-config.cjs"
      }
    },
    "./next-turbo-loader": {
      "import": {
        "types": "./dist/next-turbo-loader.d.mts",
        "default": "./dist/next-turbo-loader.mjs"
      },
      "require": {
        "types": "./dist/next-turbo-loader.d.cts",
        "default": "./dist/next-turbo-loader.cjs"
      }
    },
    "./next-prebuild": {
      "import": {
        "types": "./dist/next-prebuild.d.mts",
        "default": "./dist/next-prebuild.mjs"
      },
      "require": {
        "types": "./dist/next-prebuild.d.cts",
        "default": "./dist/next-prebuild.cjs"
      }
    },
    "./next-watcher": {
      "import": {
        "types": "./dist/next-watcher.d.mts",
        "default": "./dist/next-watcher.mjs"
      },
      "require": {
        "types": "./dist/next-watcher.d.cts",
        "default": "./dist/next-watcher.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@csszyx/compiler": "workspace:*",
    "@csszyx/core": "workspace:*",
    "@csszyx/svelte-adapter": "workspace:*",
    "@csszyx/types": "workspace:*",
    "@csszyx/vue-adapter": "workspace:*",
    "postcss": "^8.5.21",
    "postcss-selector-parser": "^7.1.4",
    "postcss-value-parser": "^4.2.0",
    "proper-lockfile": "^4.1.2",
    "unplugin": "^3.3.0"
  },
  "peerDependencies": {
    "@csszyx/runtime": "workspace:^"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@types/node": "^22.20.1",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.28.1",
    "rollup": "^4.62.2",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "webpack": "^5.108.4"
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
