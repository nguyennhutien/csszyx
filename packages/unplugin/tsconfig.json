{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "lib": ["ES2021", "DOM"],
        "incremental": true,
        "isolatedDeclarations": true,
        "declaration": true,
        "tsBuildInfoFile": "./.tsout/tsconfig.tsbuildinfo",
        "outDir": "./.tsout",
        "rootDir": "src",
        "types": ["node"]
    },
    "references": [
        { "path": "../compiler" },
        { "path": "../svelte-adapter" },
        { "path": "../types" },
        { "path": "../vue-adapter" }
    ],
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
