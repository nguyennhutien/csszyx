{
  "name": "@csszyx/compiler",
  "version": "0.7.0",
  "description": "Core compiler and transformation logic for csszyx",
  "keywords": [
    "csszyx",
    "compiler",
    "babel",
    "transform",
    "css-in-js"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/compiler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "import": "./src/transform-core.ts",
      "types": "./src/transform-core.ts"
    },
    "./color-var": {
      "types": "./dist/color-var.d.mts",
      "import": "./dist/color-var.mjs",
      "require": "./dist/color-var.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.23.7",
    "@babel/types": "^7.23.6",
    "@babel/traverse": "^7.23.7",
    "@csszyx/core": "workspace:*"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.20.5",
    "@types/node": "^20.11.0",
    "csstype": "^3.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "unbuild": "^3.6.1"
  }
}
