{
  "name": "@csszyx/compiler",
  "version": "0.10.9",
  "description": "Core compiler and transformation logic for csszyx",
  "keywords": [
    "csszyx",
    "compiler",
    "babel",
    "transform",
    "css-in-js"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/compiler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/transform-core.d.mts",
        "default": "./dist/transform-core.mjs"
      },
      "require": {
        "types": "./dist/transform-core.d.cts",
        "default": "./dist/transform-core.cjs"
      }
    },
    "./color-var": {
      "import": {
        "types": "./dist/color-var.d.mts",
        "default": "./dist/color-var.mjs"
      },
      "require": {
        "types": "./dist/color-var.d.cts",
        "default": "./dist/color-var.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.29.6",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@csszyx/core": "workspace:*",
    "magic-string": "0.30.21",
    "oxc-parser": "0.137.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.20.5",
    "@types/node": "^20.11.0",
    "csstype": "^3.0.0",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.9"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
