{
  "name": "@csszyx/compiler",
  "version": "0.17.2",
  "description": "Core compiler and transformation logic for csszyx",
  "keywords": [
    "csszyx",
    "compiler",
    "transform",
    "css-in-js"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/compiler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./engine": {
      "types": "./dist/engine.d.mts",
      "default": "./dist/engine.mjs"
    },
    "./browser": {
      "import": {
        "types": "./dist/transform-core.d.mts",
        "default": "./dist/transform-core.mjs"
      },
      "require": {
        "types": "./dist/transform-core.d.cts",
        "default": "./dist/transform-core.cjs"
      }
    },
    "./sz-limits": {
      "import": {
        "types": "./dist/sz-limits.d.mts",
        "default": "./dist/sz-limits.mjs"
      },
      "require": {
        "types": "./dist/sz-limits.d.cts",
        "default": "./dist/sz-limits.cjs"
      }
    },
    "./keyword-families": {
      "import": {
        "types": "./dist/keyword-families.d.mts",
        "default": "./dist/keyword-families.mjs"
      },
      "require": {
        "types": "./dist/keyword-families.d.cts",
        "default": "./dist/keyword-families.cjs"
      }
    },
    "./bool-class": {
      "import": {
        "types": "./dist/bool-class.d.mts",
        "default": "./dist/bool-class.mjs"
      },
      "require": {
        "types": "./dist/bool-class.d.cts",
        "default": "./dist/bool-class.cjs"
      }
    },
    "./color-var": {
      "import": {
        "types": "./dist/color-var.d.mts",
        "default": "./dist/color-var.mjs"
      },
      "require": {
        "types": "./dist/color-var.d.cts",
        "default": "./dist/color-var.cjs"
      }
    },
    "./spacing-var": {
      "import": {
        "types": "./dist/spacing-var.d.mts",
        "default": "./dist/spacing-var.mjs"
      },
      "require": {
        "types": "./dist/spacing-var.d.cts",
        "default": "./dist/spacing-var.cjs"
      }
    },
    "./report": {
      "types": "./dist/report.d.mts",
      "default": "./dist/report.mjs"
    },
    "./migrate": {
      "types": "./dist/migrate-rust.d.mts",
      "default": "./dist/migrate-rust.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.mts",
      "default": "./dist/internal.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "bench": "vitest bench --run",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "csstype": "^3.2.3",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "@csszyx/core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@csszyx/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@csszyx/core": "workspace:*",
    "@types/node": "^22.20.1",
    "oxc-parser": "0.150.0",
    "tsdown": "0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
