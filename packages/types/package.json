{
  "name": "@csszyx/types",
  "version": "0.10.11",
  "description": "TypeScript definitions for csszyx",
  "keywords": [
    "csszyx",
    "types",
    "typescript"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/types#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.cjs"
    },
    "./compiler": {
      "types": "./dist/compiler.d.mts",
      "import": "./dist/compiler.mjs",
      "require": "./dist/compiler.cjs"
    },
    "./jsx": {
      "types": "./dist/jsx.d.ts"
    },
    "./jsx-react": {
      "types": "./dist/jsx-react.d.ts"
    },
    "./jsx-solid": {
      "types": "./dist/jsx-solid.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@csszyx/compiler": "workspace:*",
    "@types/node": "^20.11.0",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  }
}
