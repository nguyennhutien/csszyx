{
  "name": "@csszyx/types",
  "version": "0.18.0",
  "description": "TypeScript definitions for csszyx",
  "keywords": [
    "csszyx",
    "types",
    "typescript"
  ],
  "author": "csszyx contributors",
  "license": "MIT",
  "homepage": "https://github.com/nguyennhutien/csszyx/tree/main/packages/types#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennhutien/csszyx.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/nguyennhutien/csszyx/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/compiler.d.mts",
        "default": "./dist/compiler.mjs"
      },
      "require": {
        "types": "./dist/compiler.d.cts",
        "default": "./dist/compiler.cjs"
      }
    },
    "./jsx": {
      "types": "./dist/jsx.d.ts"
    },
    "./jsx-react": {
      "types": "./dist/jsx-react.d.ts"
    },
    "./jsx-solid": {
      "types": "./dist/jsx-solid.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@csszyx/compiler": "workspace:*",
    "@types/node": "^22.20.1",
    "tsdown": "0.23.0",
    "typescript": "^6.0.3"
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
