{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "incremental": true,
        "isolatedDeclarations": true,
        "outDir": "./.tsout",
        "rootDir": "./src",
        "declaration": true,
        "declarationMap": true,
        "tsBuildInfoFile": "./.tsout/tsconfig.tsbuildinfo",
        "emitDeclarationOnly": false
    },
    "references": [{ "path": "../compiler" }],
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
