{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "incremental": true,
        "isolatedDeclarations": true,
        "declaration": true,
        "tsBuildInfoFile": "./.tsout/tsconfig.tsbuildinfo",
        "rootDir": "./src",
        "outDir": "./.tsout",
        "types": ["vitest/globals", "node"]
    },
    "references": [{ "path": "../compiler" }],
    "include": ["src/**/*"],
    "exclude": ["dist", "node_modules"]
}
